# Copy this file to .env and fill in keys as you get them. .env is git-ignored.

# --- Gemini (main provider) ---------------------------------------------------
# Option A: Google AI Studio key (aistudio.google.com -> Get API key)
GOOGLE_API_KEY=
# Option B: Gemini through Google Cloud / Vertex AI (a university GCP project).
# Log in once with:  gcloud auth application-default login
# then set in the run config: extra: {vertexai: true, project: <id>, location: us-central1}
GOOGLE_CLOUD_PROJECT=

# --- Optional second model family (free) --------------------------------------
GROQ_API_KEY=          # console.groq.com (free: 30 requests/min, 1,000/day)

# --- Not used unless the plan changes ------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- PubMed (optional): raises NCBI's limit from 3 to 10 requests/second ---------
NCBI_API_KEY=
NCBI_EMAIL=
